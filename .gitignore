# Translation output files
pdf2zh_files/

# Logs
logs/

# Python cache
__pycache__/
*.pyc
*.pyo

# User config
config/user.json

# Embedded Python runtime (too large for git)
core/runtime/
core/site-packages/*

# Only track our custom pdf2zh source (unignore)
!core/site-packages/pdf2zh/

# But still ignore pycache inside pdf2zh
core/site-packages/pdf2zh/__pycache__/

# Binary / large files
*.exe
*.zip
*.pyd
*.dll
*.so
*.dylib
*.onnx
cache/

# Dev artifacts
DEPLOY_TEST_REPORT.md
build_script.py
COMPLETION_SUMMARY.md
PROJECT_REFACTOR_SUMMARY.md
GITHUB_PRIVATE_SETUP.md
GITHUB_RELEASE_GUIDE.md
RELEASE_NOTES.md
CONTRIBUTING.md
pyproject.toml
requirements.txt
pdf2zh-desktop-slim/

# Local reference files (not part of the product)
reference/

# Local release build output
.release/

# Isolated Codex development worktrees
.worktrees/

# IDE / local caches
.vs/
.idea/
*.swp

# Dev workspaces (Codex / planning scratch)
computer-project-workspace/
project_init/
project_nginx/
project_workspace/
project_zips/

# Temp & test artifacts
tmp/
*.sqlite
*.db

# PyInstaller build output
launcher_src/build/
dist/
build/
