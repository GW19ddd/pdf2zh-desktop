            VALUE "ProductVersion", "2.2.0"
            VALUE "CompanyName", "PaperFlow Desktop Contributors"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "paperflow.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
